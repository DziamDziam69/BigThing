<Window x:Class="BigThing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BigThing"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="0*"/>
        </Grid.ColumnDefinitions>
        <Border Background="hotpink" Grid.ColumnSpan="2"/>
        <Border Background="pink" Margin="37,98,36,20" Grid.Column="1"/>
        <TextBlock  FontWeight="bold" FontSize="40" RenderTransformOrigin="0.494,0.534" Margin="267,10,241,352" Grid.Column="1"><Run Text="Biblioteka Gier"/></TextBlock>
        <TextBlock FontSize="20" FontWeight="bold" TextAlignment="Center" Margin="96,135,346,243" Grid.Column="1" Text="Nazwa Gry"></TextBlock>
        <TextBox x:Name="NazwaGry" Text="Wpisz Nazwę Gry" RenderTransformOrigin="0.74,0.491" Margin="352,135,266,243" Grid.Column="1"/>
        <TextBlock FontSize="20" FontWeight="bold" TextAlignment="Center" Margin="96,173,346,204" Grid.Column="1" Text="Opis Gry"></TextBlock>
        <TextBox x:Name="Opis" Text="Opis"  RenderTransformOrigin="0.74,0.491" Margin="352,173,266,204" Grid.Column="1"/>
        <TextBlock FontSize="20" FontWeight="bold" TextAlignment="Center" Margin="96,208,346,169" Grid.Column="1" Text="Gatunek Gry"></TextBlock>
        <ComboBox x:Name="GatunekGryComboBox" Grid.Column="1" Margin="352,214,266,169" SelectionChanged="ComboBox_SelectionChanged">
            <ComboBoxItem Content="FPS"/>
            <ComboBoxItem Content="Action"/>
            <ComboBoxItem Content="Survival"/>
            <ComboBoxItem Content="RPG"/>
            <ComboBoxItem Content="Strategy"/>
            <ComboBoxItem Content="Puzzle"/>
            <ComboBoxItem Content="Simulator"/>
        </ComboBox>
        <Button Grid.Column="1" Margin="128,325,400,48" Background="PaleVioletRed" FontWeight="Bold" FontSize="20" Click="Button_Dodaj_Click">Dodaj</Button>
        <Button Grid.Column="1" Margin="400,325,128,48" Background="PaleVioletRed" FontWeight="Bold" FontSize="20">Wyswietl Wszystkie</Button>

    </Grid>
</Window>